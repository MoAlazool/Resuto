{
  "name": "resuto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/check-source.mjs",
    "test:browser": "python scripts/premium_smoke.py",
    "test:experience": "python scripts/experience_smoke.py",
    "test:editor": "python scripts/editor_smoke.py",
    "test:data": "python scripts/data_guest_smoke.py",
    "package:netlify": "node scripts/package-netlify.mjs",
    "test:browser:legacy": "python scripts/browser_smoke.py",
    "test:owner-ai": "python scripts/owner_ai_smoke.py"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.3",
    "@netlify/database": "^2.0.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@netlify/database-dev": "^1.0.1",
    "@netlify/zip-it-and-ship-it": "^15.5.0"
  },
  "overrides": {
    "toml": "^4.2.0"
  }
}
