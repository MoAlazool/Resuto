PORT=3000
APP_ORIGIN=http://localhost:3000
MANAGER_PASSWORD=change-this-manager-password
KITCHEN_PASSWORD=change-this-kitchen-password
# Optional: real Gemini recommendations. Otherwise visibly labeled demo rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Netlify supplies NETLIFY_DB_URL automatically; DATABASE_URL supports external Postgres.
DATABASE_URL=
# test allows simulated ledger payments; live disables them. Test gateway keys may
# be used independently for provider sandbox verification before launch.
PAYMENT_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
# Optional POS menu draft adapters (review before import; no order push).
FOODICS_API_TOKEN=
ODOO_URL=
ODOO_API_KEY=
ODOO_DATABASE=
# Set EGP only after verifying the Odoo product currency.
ODOO_CURRENCY=
